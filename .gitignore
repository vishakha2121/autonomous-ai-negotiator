│ └──────┬──────────────┬──────────────┬─────────────────┘ │
│ ▼ ▼ ▼ │
│ ┌──────────┐ ┌──────────┐ ┌───────────┐ │
│ │ BUYER │ │ SELLER │ │ MEDIATOR │ │
│ │ AGENT │ │ AGENT │ │ AGENT │ │
│ └────┬─────┘ └────┬─────┘ └─────┬─────┘ │
│ │ │ │ │
│ └──────────────┴───────────────┘ │
│ ▼ │
│ ┌─────────────────────────┐ │
│ │ CONSTRAINT OPTIMIZER │ │
│ │ (OR-Tools LP) │ │
│ └────────────┬────────────┘ │
│ ▼ │
│ ┌─────────────────────────┐ │
│ │ LLM CLIENT (OpenAI) │ │
│ └─────────────────────────┘ │
└────────────────────────────┬────────────────────────────────┘
